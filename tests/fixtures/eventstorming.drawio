<mxfile host="drawio-spatial">
  <diagram id="eventstorming" name="Event storming" spatial.mode="eventstorming">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Commande en ligne" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=64;fontColor=#DEDEDE;" vertex="1" parent="1">
          <mxGeometry x="40" y="-120" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="actor" value="Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff59d;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-actor;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="command" value="Payer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#64b5f6;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-command;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="event" value="Paiement effectué" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-event;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="Quand le paiement échoue, prévenir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-policy;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="constraint" value="Pas plus que le stock disponible" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cfd8dc;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-constraint;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="system" value="Prestataire de paiement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f48fb1;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-system;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="query" value="Historique des commandes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-query;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="hotspot" value="Règle floue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e57373;strokeColor=none;shadow=1;fontColor=#000000;spacing=8;fitText=fill;spatial.kind=eventstorming-hotspot;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="text" value="Coin seul : pas de contact. À droite : chevauchement signalé." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="420" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
